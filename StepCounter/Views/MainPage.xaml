<Page
    x:Class="StepCounter.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StepCounter.ViewModels"
    xmlns:controls="using:StepCounter.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="CaptionMutedStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
    </Page.Resources>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Icon="GoToToday" Label="сегодня" Click="OnTodayClick" />
            <AppBarButton Icon="Refresh" Label="обновить" Click="OnRefreshClick" />
            <AppBarButton Icon="Setting" Label="настройки" Click="OnSettingsClick" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок и состояние датчика -->
        <StackPanel Padding="12,8,12,0">
            <TextBlock Text="ШАГОМЕР"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}"
                       Style="{StaticResource CaptionMutedStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                       TextWrapping="Wrap" />
            <HyperlinkButton Content="Разрешить доступ к данным о движении"
                             NavigateUri="ms-settings:privacy-motion"
                             Padding="0,4"
                             Visibility="{x:Bind ViewModel.IsAccessHintVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Дни: свайп вправо — предыдущий день -->
        <FlipView x:Name="DaysFlipView"
                  Grid.Row="1"
                  Loaded="OnFlipViewLoaded"
                  Background="Transparent"
                  ItemsSource="{x:Bind ViewModel.Days}"
                  SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}">
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="vm:DayViewModel">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel Padding="12,4,12,24">

                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                       Style="{StaticResource SubheaderTextBlockStyle}" />

                            <!-- Нет записей за день -->
                            <StackPanel Margin="0,48,0,0"
                                        Visibility="{x:Bind IsNoData, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Нет данных"
                                           Style="{StaticResource HeaderTextBlockStyle}"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Text="За этот день записей о шагах нет."
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>

                            <StackPanel Visibility="{x:Bind HasData, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                                <!-- Шаги и ккал -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind StepsText, Mode=OneWay}"
                                                   FontSize="60"
                                                   FontWeight="Light"
                                                   Foreground="{StaticResource StepsBrush}" />
                                        <TextBlock Text="{x:Bind GoalText, Mode=OneWay}"
                                                   Style="{StaticResource CaptionMutedStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind KcalText, Mode=OneWay}"
                                                   FontSize="34"
                                                   FontWeight="Light"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource KcalBrush}" />
                                        <TextBlock Text="ккал"
                                                   Style="{StaticResource CaptionMutedStyle}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Value="{x:Bind Progress, Mode=OneWay}"
                                             Maximum="100"
                                             Height="8"
                                             Margin="0,10,0,0"
                                             Foreground="{StaticResource StepsBrush}" />

                                <!-- Поощрение / мотивация -->
                                <TextBlock Text="{x:Bind MotivationText, Mode=OneWay}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           FontStyle="Italic"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="{x:Bind KcalHint, Mode=OneWay}"
                                           Style="{StaticResource CaptionMutedStyle}" />

                                <!-- Тренировки, время активности, расстояние -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind WorkoutsText, Mode=OneWay}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind WorkoutsLabel, Mode=OneWay}"
                                                   Style="{StaticResource CaptionMutedStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind ActiveTimeText, Mode=OneWay}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="время активности"
                                                   Style="{StaticResource CaptionMutedStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Bind DistanceText, Mode=OneWay}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="км"
                                                   Style="{StaticResource CaptionMutedStyle}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Активность по часам -->
                                <Grid Margin="0,20,0,4">
                                    <TextBlock Text="активность по часам"
                                               Style="{StaticResource BaseTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Rectangle Width="10" Height="10" Fill="{StaticResource StepsBrush}" Margin="0,0,4,0" />
                                        <TextBlock Text="шаги" Style="{StaticResource CaptionMutedStyle}" Margin="0,0,12,0" />
                                        <Rectangle Width="10" Height="10" Fill="{StaticResource KcalBrush}" Margin="0,0,4,0" />
                                        <TextBlock Text="ккал" Style="{StaticResource CaptionMutedStyle}" />
                                    </StackPanel>
                                </Grid>
                                <controls:HourlyChart Bars="{x:Bind Hourly, Mode=OneWay}" Height="120" />

                                <!-- Средние значения -->
                                <TextBlock Text="в среднем за день"
                                           Style="{StaticResource BaseTextBlockStyle}"
                                           Margin="0,20,0,0" />
                                <TextBlock Text="по прошедшим дням, где есть данные"
                                           Style="{StaticResource CaptionMutedStyle}"
                                           Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Text="неделя" Style="{StaticResource CaptionMutedStyle}" />
                                    <TextBlock Grid.Column="1" Text="месяц" Style="{StaticResource CaptionMutedStyle}" />
                                    <TextBlock Grid.Column="2" Text="год" Style="{StaticResource CaptionMutedStyle}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind Averages.WeekSteps, Mode=OneWay}"
                                               Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource StepsBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Averages.MonthSteps, Mode=OneWay}"
                                               Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource StepsBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind Averages.YearSteps, Mode=OneWay}"
                                               Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource StepsBrush}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource KcalBrush}">
                                        <Run Text="{x:Bind Averages.WeekKcal, Mode=OneWay}" /> ккал
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource KcalBrush}">
                                        <Run Text="{x:Bind Averages.MonthKcal, Mode=OneWay}" /> ккал
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource KcalBrush}">
                                        <Run Text="{x:Bind Averages.YearKcal, Mode=OneWay}" /> ккал
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>

        <!-- Праздник при выполнении нормы -->
        <controls:CelebrationOverlay x:Name="Celebration" Grid.RowSpan="2" />
    </Grid>
</Page>
