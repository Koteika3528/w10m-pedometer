<Page
    x:Class="StepCounter.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StepCounter.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="CaptionMutedStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Padding="12,8,12,24">
            <TextBlock Text="ШАГОМЕР"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold" />
            <TextBlock Text="статистика"
                       Style="{StaticResource HeaderTextBlockStyle}"
                       Margin="0,0,0,8" />

            <!-- Выбор периода -->
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="WeekButton" Content="неделя" GroupName="Period" MinWidth="0" Margin="0,0,16,0" Checked="OnPeriodChecked" />
                <RadioButton x:Name="MonthButton" Content="месяц" GroupName="Period" MinWidth="0" Margin="0,0,16,0" Checked="OnPeriodChecked" />
                <RadioButton x:Name="YearButton" Content="год" GroupName="Period" MinWidth="0" Checked="OnPeriodChecked" />
            </StackPanel>

            <!-- Листание периодов -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Click="OnPreviousClick" Background="Transparent" Padding="12,8">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.PeriodTitle, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
                <Button Grid.Column="2"
                        Click="OnNextClick"
                        Background="Transparent"
                        Padding="12,8"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}">
                    <SymbolIcon Symbol="Forward" />
                </Button>
            </Grid>

            <!-- Нет данных за период -->
            <StackPanel Margin="0,40,0,0"
                        Visibility="{x:Bind ViewModel.IsNoData, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Нет данных"
                           Style="{StaticResource HeaderTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Text="За этот период записей о шагах нет."
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

            <StackPanel Visibility="{x:Bind ViewModel.HasData, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                <!-- Средние -->
                <TextBlock Text="в среднем в день"
                           Style="{StaticResource BaseTextBlockStyle}"
                           Margin="0,12,0,0" />
                <TextBlock Text="по прошедшим дням, где есть данные"
                           Style="{StaticResource CaptionMutedStyle}" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.AvgSteps, Mode=OneWay}"
                                   FontSize="48"
                                   FontWeight="Light"
                                   Foreground="{StaticResource StepsBrush}" />
                        <TextBlock Text="шагов" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind ViewModel.AvgKcal, Mode=OneWay}"
                                   FontSize="34"
                                   FontWeight="Light"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource KcalBrush}" />
                        <TextBlock Text="ккал" Style="{StaticResource CaptionMutedStyle}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.AvgDistance, Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                        <TextBlock Text="км" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind ViewModel.AvgActive, Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                        <TextBlock Text="время активности" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Диаграмма периода -->
                <Grid Margin="0,20,0,4">
                    <TextBlock Text="{x:Bind ViewModel.ChartTitle, Mode=OneWay}"
                               Style="{StaticResource BaseTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Rectangle Width="10" Height="10" Fill="{StaticResource StepsBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="шаги" Style="{StaticResource CaptionMutedStyle}" Margin="0,0,12,0" />
                        <Rectangle Width="10" Height="10" Fill="{StaticResource KcalBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="ккал" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                </Grid>
                <controls:BarChart Bars="{x:Bind ViewModel.Bars, Mode=OneWay}" Height="120" />

                <!-- Итоги периода -->
                <TextBlock Text="всего за период"
                           Style="{StaticResource BaseTextBlockStyle}"
                           Margin="0,20,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TotalSteps, Mode=OneWay}" Style="{StaticResource ValueStyle}" Foreground="{StaticResource StepsBrush}" />
                        <TextBlock Text="шагов" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind ViewModel.TotalKcal, Mode=OneWay}" Style="{StaticResource ValueStyle}" Foreground="{StaticResource KcalBrush}" />
                        <TextBlock Text="ккал" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Bind ViewModel.TotalDistance, Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                        <TextBlock Text="км" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="{x:Bind ViewModel.TotalWorkouts, Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                        <TextBlock Text="тренировок" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <TextBlock Text="{x:Bind ViewModel.TotalActive, Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                        <TextBlock Text="время активности" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Дни -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="норма выполнена, дней" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.GoalDays, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" />

                    <TextBlock Grid.Row="1" Text="дней с данными" Style="{StaticResource BodyTextBlockStyle}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DataDays, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="2" Text="лучший день" Style="{StaticResource BodyTextBlockStyle}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.BestDay, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Margin="0,6,0,0" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
