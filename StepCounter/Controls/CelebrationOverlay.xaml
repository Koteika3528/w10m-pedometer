<UserControl
    x:Class="StepCounter.Controls.CelebrationOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed"
    Tapped="OnTapped">

    <Grid x:Name="Root" Background="#99000000">
        <Canvas x:Name="ConfettiCanvas" IsHitTestVisible="False" />

        <Border x:Name="MessageCard"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                Padding="24,20"
                CornerRadius="8"
                Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <CompositeTransform x:Name="CardTransform" />
            </Border.RenderTransform>
            <StackPanel>
                <TextBlock Text="🎉"
                           FontSize="56"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI Emoji" />
                <TextBlock Text="Норма выполнена!"
                           Style="{StaticResource SubheaderTextBlockStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock x:Name="CheerText"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Foreground="{StaticResource KcalBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
                <TextBlock x:Name="StepsText"
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,8,0,0" />
                <TextBlock Text="коснитесь, чтобы закрыть"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
