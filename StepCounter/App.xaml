<Application
    x:Class="StepCounter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:StepCounter.Converters">

    <Application.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Цвета диаграммы: синий — шаги, оранжевый — ккал -->
        <Color x:Key="StepsColor">#FF1E88E5</Color>
        <Color x:Key="KcalColor">#FFFF9800</Color>
        <SolidColorBrush x:Key="StepsBrush" Color="{StaticResource StepsColor}" />
        <SolidColorBrush x:Key="KcalBrush" Color="{StaticResource KcalColor}" />
    </Application.Resources>
</Application>
